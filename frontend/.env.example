# Backend API (must match where `npm run backend` listens)
VITE_API_BASE_URL=http://localhost:5000

# Firebase (web app)
VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# Optional: Geoapify for booking city autocomplete / cabs (browser)
# VITE_GEOAPIFY_API_KEY=

# OpenWeather & RapidAPI keys live on the SERVER — see backend/.env.example

# Cohere (Yavi AI floating chat — exposed to browser; use a restricted key if possible)
VITE_COHERE_API_KEY=your_cohere_api_key
