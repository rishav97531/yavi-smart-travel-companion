# Server
PORT=5000

# MongoDB
MONGO_URI=your_mongodb_connection_string

# Firebase Admin (JSON on one line or path — match your project)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# Allowed frontend origins (comma-separated)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# --- OpenWeatherMap (current weather) ---
# Get a key: https://openweathermap.org/api
# Used by: GET /api/places/weather/:city (auth) and GET /api/weather?city=... (no auth on weather route — still uses this key server-side)
OPENWEATHER_API_KEY=your_openweather_api_key

# --- RapidAPI (hotels in booking search) ---
# Key: https://rapidapi.com → subscribe to your hotels API (e.g. Booking.com)
# Host MUST match the "X-RapidAPI-Host" shown for that API (example below is common for Booking.com)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOTELS_HOST=booking-com.p.rapidapi.com

# --- Amadeus (flights, booking API) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Cohere (AI chat / Yavi assistant) ---
COHERE_API_KEY=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Geoapify (places / nearby — if used) ---
GEOAPIFY_API_KEY=
